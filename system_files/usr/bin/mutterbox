#!/usr/bin/bash

set -uo pipefail

show_error() {
  zenity --error --title='Mutterbox' --text="$1" 2>/dev/null || printf 'Mutterbox: %s\n' "$1" >&2
}

choose_desktop_app() {
  local desktop_file desktop_id name hidden
  local -a rows=()
  declare -A seen=()

  while IFS= read -r -d '' desktop_file; do
    desktop_id=${desktop_file##*/}
    desktop_id=${desktop_id%.desktop}
    [[ $desktop_id == org.mightydisciple.Mutterbox ]] && continue
    [[ $desktop_id == org.mightydisciple.UnityMutterbox ]] && continue
    [[ -v seen[$desktop_id] ]] && continue
    seen[$desktop_id]=1

    hidden=$(sed -n 's/^\(Hidden\|NoDisplay\)=//p' "$desktop_file" | head -n 1)
    [[ ${hidden,,} == true ]] && continue
    name=$(sed -n 's/^Name=//p' "$desktop_file" | head -n 1)
    [[ -n $name ]] || continue
    rows+=("$name" "$desktop_id")
  done < <(
    find \
      "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
      /usr/local/share/applications \
      /usr/share/applications \
      -maxdepth 1 -type f -name '*.desktop' -print0 2>/dev/null
  )

  if ((${#rows[@]} == 0)); then
    show_error 'Er zijn geen applicatielaunchers gevonden.'
    return 1
  fi

  zenity --list \
    --title='Open in Mutterbox' \
    --text='Kies een applicatie' \
    --print-column=2 \
    --hide-column=2 \
    --width=640 \
    --height=720 \
    --column='Applicatie' \
    --column='Desktop-ID' \
    "${rows[@]}"
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  cat <<'EOF'
Gebruik:
  mutterbox                         Kies een applicatie uit een lijst
  mutterbox --desktop DESKTOP-ID    Start een .desktop-applicatie
  mutterbox -- COMMAND [ARGUMENTEN] Start een commando
  mutterbox COMMAND [ARGUMENTEN]    Start een commando

Mutterbox draait de applicatie in een nested Mutter-compositor. De buitenste
titelbalk blijft zichtbaar; de dubbele titelbalk van het grote X11-hoofdvenster
wordt automatisch verwijderd.
EOF
  exit 0
fi

if ! command -v mutter >/dev/null; then
  show_error 'mutter-devkit is niet geïnstalleerd. Installeer eerst de bijgewerkte Bazzite-image.'
  exit 1
fi

if (($# == 0)); then
  desktop_id=$(choose_desktop_app) || exit $?
  [[ -n $desktop_id ]] || exit 0
  set -- --desktop "$desktop_id"
elif [[ $1 == -- ]]; then
  shift
fi

if (($# == 0)); then
  show_error 'Geen applicatie of commando opgegeven.'
  exit 2
fi

session_helper=${MUTTERBOX_SESSION_HELPER:-/usr/libexec/mutterbox-session}
host_runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
outer_wayland_display=${WAYLAND_DISPLAY:-wayland-0}
host_display=${DISPLAY:-}
host_xauthority=${XAUTHORITY:-}
host_dbus_session_bus_address=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$host_runtime_dir/bus}
if [[ $outer_wayland_display != /* ]]; then
  outer_wayland_display="$host_runtime_dir/$outer_wayland_display"
fi

mutterbox_runtime=$(mktemp -d "$host_runtime_dir/mutterbox.XXXXXX") || {
  show_error 'De tijdelijke Mutterbox-runtime kon niet worden aangemaakt.'
  exit 1
}
chmod 0700 "$mutterbox_runtime"

cleanup_runtime() {
  case $mutterbox_runtime in
    "$host_runtime_dir"/mutterbox.*)
      if mountpoint -q "$mutterbox_runtime/doc" 2>/dev/null; then
        fusermount3 -u "$mutterbox_runtime/doc" 2>/dev/null || true
      fi
      rm -rf -- "$mutterbox_runtime"
      ;;
  esac
}
trap cleanup_runtime EXIT HUP INT TERM

# Preserve multimedia access without sharing portal and display state. Unix
# sockets can safely be reached through these per-session symbolic links.
for runtime_socket in pipewire-0 pipewire-0-manager; do
  if [[ -S $host_runtime_dir/$runtime_socket ]]; then
    ln -s "$host_runtime_dir/$runtime_socket" "$mutterbox_runtime/$runtime_socket"
  fi
done
if [[ -d $host_runtime_dir/pulse ]]; then
  ln -s "$host_runtime_dir/pulse" "$mutterbox_runtime/pulse"
fi

XDG_RUNTIME_DIR=$mutterbox_runtime \
WAYLAND_DISPLAY=$outer_wayland_display \
dbus-run-session -- \
  mutter --wayland --devkit -- \
  "$session_helper" \
    --host-runtime "$host_runtime_dir" \
    --host-wayland-display "$outer_wayland_display" \
    --host-display "$host_display" \
    --host-xauthority "$host_xauthority" \
    --host-bus "$host_dbus_session_bus_address" \
    -- "$@"
