#!/usr/bin/bash

set -uo pipefail

show_error() {
  zenity --error --title='Labwcbox' --text="$1" 2>/dev/null || printf 'Labwcbox: %s\n' "$1" >&2
}

choose_desktop_app() {
  local desktop_file desktop_id name hidden
  local -a rows=()
  declare -A seen=()

  while IFS= read -r -d '' desktop_file; do
    desktop_id=${desktop_file##*/}
    desktop_id=${desktop_id%.desktop}
    [[ $desktop_id == org.mightydisciple.Labwcbox ]] && continue
    [[ $desktop_id == org.mightydisciple.UnityLabwcbox ]] && continue
    [[ -v seen[$desktop_id] ]] && continue
    seen[$desktop_id]=1

    hidden=$(sed -n 's/^\(Hidden\|NoDisplay\)=//p' "$desktop_file" | head -n 1)
    [[ ${hidden,,} == true ]] && continue
    name=$(sed -n 's/^Name=//p' "$desktop_file" | head -n 1)
    [[ -n $name ]] || continue
    rows+=("$name" "$desktop_id")
  done < <(
    find \
      "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
      /usr/local/share/applications \
      /usr/share/applications \
      -maxdepth 1 -type f -name '*.desktop' -print0 2>/dev/null
  )

  ((${#rows[@]} > 0)) || return 1
  zenity --list \
    --title='Open in Labwcbox' \
    --text='Kies een applicatie' \
    --print-column=2 \
    --hide-column=2 \
    --width=640 \
    --height=720 \
    --column='Applicatie' \
    --column='Desktop-ID' \
    "${rows[@]}"
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  cat <<'EOF'
Gebruik:
  labwcbox
  labwcbox --desktop DESKTOP-ID
  labwcbox -- COMMAND [ARGUMENTEN]
  labwcbox COMMAND [ARGUMENTEN]

Start een applicatie in een geneste Labwc-compositor onder Niri.
EOF
  exit 0
fi

command -v labwc >/dev/null || {
  show_error 'Labwc is niet geïnstalleerd.'
  exit 1
}

if (($# == 0)); then
  desktop_id=$(choose_desktop_app) || exit $?
  [[ -n $desktop_id ]] || exit 0
  set -- --desktop "$desktop_id"
elif [[ ${1:-} == -- ]]; then
  shift
fi
if (($# == 0)); then
  show_error 'Geen applicatie of commando opgegeven.'
  exit 2
fi

host_runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
outer_wayland_display=${WAYLAND_DISPLAY:-wayland-0}
host_display=${DISPLAY:-}
host_xauthority=${XAUTHORITY:-}
host_bus=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$host_runtime_dir/bus}
if [[ $outer_wayland_display != /* ]]; then
  outer_wayland_display="$host_runtime_dir/$outer_wayland_display"
fi

labwcbox_runtime=$(mktemp -d "$host_runtime_dir/labwcbox.XXXXXX") || {
  show_error 'De tijdelijke Labwcbox-runtime kon niet worden aangemaakt.'
  exit 1
}
chmod 0700 "$labwcbox_runtime"

cleanup_runtime() {
  case $labwcbox_runtime in
    "$host_runtime_dir"/labwcbox.*)
      rm -rf -- "$labwcbox_runtime"
      ;;
  esac
}
trap cleanup_runtime EXIT HUP INT TERM

command_file=$labwcbox_runtime/command
printf '%s\0' "$@" >"$command_file"
export LABWCBOX_COMMAND_FILE="$command_file"
export LABWCBOX_HOST_RUNTIME_DIR="$host_runtime_dir"
export LABWCBOX_HOST_WAYLAND_DISPLAY="$outer_wayland_display"
export LABWCBOX_HOST_DISPLAY="$host_display"
export LABWCBOX_HOST_XAUTHORITY="$host_xauthority"
export LABWCBOX_HOST_DBUS_SESSION_BUS_ADDRESS="$host_bus"

XDG_RUNTIME_DIR=$host_runtime_dir \
WAYLAND_DISPLAY=$outer_wayland_display \
DBUS_SESSION_BUS_ADDRESS=$host_bus \
LABWC_UPDATE_ACTIVATION_ENV=0 \
NO_AT_BRIDGE=1 \
GTK_USE_PORTAL=0 \
labwc --config /usr/share/labwcbox/rc.xml \
  --session /usr/libexec/labwcbox-session
