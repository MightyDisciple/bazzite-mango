# Build the pinned Looking Glass client against the same userspace as the
# workstation image, then publish only its installed files as a tiny artifact.
FROM scratch AS looking-glass-ctx
COPY build_files/install_looking_glass.sh /

FROM ghcr.io/ublue-os/bazzite-gnome-nvidia:stable AS builder
RUN --mount=type=bind,from=looking-glass-ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/install_looking_glass.sh

FROM scratch
COPY --from=builder /out/ /

LABEL org.opencontainers.image.source="https://github.com/MightyDisciple/bazzite-dx"
LABEL org.opencontainers.image.description="Prebuilt Looking Glass B7 client for MightyDisciple Bazzite DX"
